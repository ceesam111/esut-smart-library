NEXT_PUBLIC_APP_URL=

# NEXT_PUBLIC variables are visible in the browser. Use anon/publishable values only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_BASE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Legacy public aliases. Use anon/publishable values only.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SERVICE_ROLE_KEY is server-side only. Never expose it to browser builds.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=

# Vercel AI Gateway. Server-side only.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_FAST_MODEL=openai/gpt-4o-mini
AI_REASONING_MODEL=openai/gpt-4o
AI_MAX_TOKENS_DEFAULT=1200
AI_TEMPERATURE_DEFAULT=0.2

# Free-first AI provider chain: ollama -> gemini -> groq -> nvidia -> gateway.
# Only configured providers are used; the paid gateway stays the last resort.
AI_PROVIDER_ORDER=ollama,gemini,groq,nvidia,gateway
AI_PROVIDER_BREAKER_MS=60000
AI_PROVIDER_BREAKER_THRESHOLD=3

# Ollama (local, private). Opt-in: set OLLAMA_ENABLED=true or OLLAMA_BASE_URL.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# Google Gemini free tier (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# Groq free tier (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM free developer tier (https://build.nvidia.com/keys) — optional.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Backblaze B2. Server-side only.
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_LIBRARY_FILES=
B2_BUCKET_BACKUPS=
B2_BUCKET_EXPORTS=
B2_PUBLIC_BASE_URL=

# Optional external metadata APIs.
CORE_API_KEY=
NCBI_API_KEY=
GOOGLE_BOOKS_KEY=
SEMANTIC_SCHOLAR_KEY=
ZENODO_TOKEN=
DISCOURSE_URL=
DISCOURSE_SECRET=

# Email and notifications. Server-side only unless explicitly NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=ESUT Library
VAPID_PRIVATE_KEY=

# Smart Library worker service.
WORKER_ID=smart-library-worker-1
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
WORKER_LOCK_TIMEOUT_MINUTES=15
WORKER_HEALTH_PORT=8787

# API security and Arcjet. Server-side only.
ARCJET_KEY=
ARC_JET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SENSITIVE_MAX=60
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000

# App/runtime settings.
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
