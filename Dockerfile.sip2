FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN (while true; do echo 'npm ci --omit=dev still running...'; sleep 20; done) & heartbeat=$!; npm ci --omit=dev --no-audit --no-fund; status=$?; kill "$heartbeat" >/dev/null 2>&1 || true; wait "$heartbeat" 2>/dev/null || true; exit "$status"

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 sip2 && adduser --system --uid 1001 sip2

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./package.json
COPY tsconfig.json ./tsconfig.json
COPY config ./config
COPY src ./src
COPY sip2 ./sip2

USER sip2
EXPOSE 6000 8788
CMD ["npm", "run", "sip2"]
